{
  "name": "consultoria-fiscal-sv",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "functions",
    "shared"
  ],
  "scripts": {
    "dev": "firebase emulators:start",
    "build": "npm run build -w shared && npm run build -w frontend && npm run build -w functions",
    "test": "npm test -w functions",
    "test:rules": "firebase emulators:exec --only firestore \"node --test firestore.rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.18.0"
  }
}
